<% if (items.length == 0){ %>
        <p class="coming-soon">No items reported</p>
      <% } else { %>
        <div>
          <% items.forEach(item => { %>
            <article>
              <h3><%= item.title %></h3>
              <p>
                <%= item.location %>
                <% if (item.date) { %> · <%= item.date.toISOString().slice(0, 10) %><% } %>
                <% if (item.category) { %> · <%= item.category %><% } %>
              </p>
              <% if (item.description) { %>
                <p><%= item.description %></p>
              <% } %>

              <p>Contact: <%= item.contact %></p>
              <div>
                <details>
                  <summary>Edit</summary>
                  <%- include('./item-form', {
                    item: item,
                    action: '/items/' + item._id + '/edit',
                    buttonLabel: 'Save Changes'
                  }) %>
                </details>
                <form action="/items/<%= item._id %>/delete" method="POST" onsubmit="return confirm('Delete this item?');">
                  <button type="submit">Delete</button>
                </form>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>